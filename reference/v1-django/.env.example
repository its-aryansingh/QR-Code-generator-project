# ==============================================================================
# QRit Backend Production Environment Configuration Template
# ==============================================================================

# Core Django Settings
DEBUG=False
PORT=8084
DJANGO_SECRET_KEY=generate-a-strong-random-50-char-key-here
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com,localhost

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/qrapp
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# Authentication & JWT Security
JWT_SECRET=generate-a-strong-random-64-char-secret-here
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=7
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_RESET_TOKEN_EXPIRY_HOURS=1
AUTH_VERIFICATION_TOKEN_EXPIRY_HOURS=24
AUTH_MAX_REGISTER_PER_IP_PER_HOUR=5
AUTH_MAX_LOGIN_PER_IP_PER_15MIN=10

# Application URLs & Routing
APP_BASE_URL=https://app.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
SHORT_LINK_BASE_URL=https://api.yourdomain.com
SECURE_SSL_REDIRECT=True

# CORS & CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Transactional Email Backend ('console' for local dev, 'resend' for production)
EMAIL_BACKEND=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Google OAuth (ID token verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Logging
LOG_LEVEL=INFO
