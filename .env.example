# QRit v3 Environment Configuration (.env.example)
# Appendix A defines the authoritative names and defaults.

# Environment and Django
APP_ENV=local
DJANGO_SETTINGS_MODULE=qrit.settings.api
DJANGO_SECRET_KEY=local-insecure-secret-key-change-in-production-min-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,healthcheck.railway.app

# Databases (PostgreSQL 17)
DATABASE_URL=postgresql://qrit_app:qrit_dev_password@localhost:5432/qrit
DATABASE_UNPOOLED_URL=
DATABASE_OWNER_URL=
DB_POOL_MIN=0
DB_POOL_MAX=4
DB_APP_PASSWORD=
V1_DATABASE_URL=
DISABLE_SERVER_SIDE_CURSORS=false

# Redis (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Domains and Routing
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080
LEGACY_BACKEND_HOST=localhost:8080
SHORT_DOMAIN=localhost:8090
SHORT_DOMAIN_SCHEME=http
SANDBOX_SHORT_DOMAIN=sandbox.localhost:8090
LEGACY_HOSTS=

# Edge and Header Trust
EDGE_SHARED_SECRET=local-edge-secret-at-least-32-chars-long
EDGE_SHARED_SECRET_PREVIOUS=

# Authentication and Cryptography
JWT_ED25519_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIHsV70EaTfZ+kS1xM6g6eM+VpD7kP8E3jK1qR9sT2uX/
JWT_KEY_ID=dev-key-1
JWT_PREVIOUS_PUBLIC_KEYS=[]
APP_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXktMzJieXRlcw==
SCAN_SALT_SECRET=local-scan-salt-secret-32-bytes-minimum
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=
AUTH_MAX_LOGIN_ATTEMPTS=5

# Object Storage (S3 / MinIO / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=qrit-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadminpassword
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/qrit-dev
AUDIT_ANCHOR_BUCKET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=QRit <notifications@qrit.link>

# Identity and Trust Providers
GOOGLE_CLIENT_ID=
WEB_RISK_API_KEY=
DOH_URL=https://cloudflare-dns.com/dns-query
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_SAAS_CNAME_TARGET=
CF_KV_NAMESPACE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments & Billing (Razorpay + Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LEGACY_PRICE_MAP={}

# GST and Invoicing
SELLER_LEGAL_NAME=QRit Technologies
SELLER_GSTIN=
SELLER_STATE_CODE=27
SELLER_ADDRESS=
SELLER_SAC=998314
SELLER_LUT_REF=
SELLER_UPI_VPA=
SELLER_BANK_DETAILS={}
PRICES_INCLUDE_GST=true

# Security, Staff & Limits
SERIAL_MAC_KEY=local-serial-mac-key-32-bytes-minimum
VERIFY_TOKEN_KEY=local-verify-token-key-32-bytes-min
STAFF_IP_ALLOWLIST=
FREE_TIER_DAILY_LIMIT=5

# Observability and Concurrency
SENTRY_DSN=
LOG_LEVEL=INFO
METRICS_TOKEN=local-metrics-token
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=4
LEGACY_GEOIP_LOOKUP_URL=
