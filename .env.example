# QRit v2 Environment Variables Configuration

# Global
APP_ENV=local
LOG_LEVEL=debug
METRICS_ADDR=:9090

# Databases
DATABASE_URL=postgres://qrit:qrit_dev_password@localhost:5432/qrit?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# API Service (:8080)
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
PLATFORM_SHORT_DOMAIN=localhost:8090
PLATFORM_SHORT_DOMAIN_FREE=localhost:8090
CDN_BASE_URL=http://localhost:9000/public

# Security & Cryptography
# Base64 encoded Ed25519 private key (PKCS#8)
JWT_ED25519_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIHsV70EaTfZ+kS1xM6g6eM+VpD7kP8E3jK1qR9sT2uX/
JWT_KEY_ID=dev-key-1
# Base64 encoded 32-byte encryption key for AES-256-GCM
APP_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXktMzJieXRlcw==
COOKIE_SECURE=false

# Third-Party Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/oauth/google/callback
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
WEB_RISK_API_KEY=

# Render Service (:8081)
RENDER_URL=http://localhost:8081
RENDER_SHARED_SECRET=dev-render-secret

# Object Storage (MinIO / S3 / R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_PUBLIC=public
S3_BUCKET_PRIVATE=private

# Redirect Service (:8090)
WEB_INTERNAL_URL=http://localhost:3000
LRU_SIZE=100000
LRU_TTL=30s
EVENT_BUFFER_SIZE=100000

# Frontend Web (:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHORT_DOMAIN=localhost:8090
NEXT_PUBLIC_CDN_URL=http://localhost:9000/public
API_INTERNAL_URL=http://localhost:8080
