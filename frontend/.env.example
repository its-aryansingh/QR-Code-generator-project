# Runtime (read by the server on every request; no rebuild needed)
# Where the /api/v1 proxy forwards to. On Railway:
#   BACKEND_INTERNAL_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
BACKEND_INTERNAL_URL=http://127.0.0.1:8084

# Build time (baked into the bundle). Leave NEXT_PUBLIC_API_URL unset so the
# browser uses the same-origin proxy.
# NEXT_PUBLIC_API_URL=
# Public backend URL, used to display short links (/r/<code>).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8084
NEXT_PUBLIC_APP_URL=http://localhost:3000
